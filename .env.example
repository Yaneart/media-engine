HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MEDIA_ENGINE_RATE_LIMIT_WINDOW_MS=60000
MEDIA_ENGINE_RATE_LIMIT_MAX_REQUESTS=60
MEDIA_ENGINE_PROVIDER_TIMEOUT_MS=5000
MEDIA_ENGINE_STREAMING_PROVIDER_TIMEOUT_MS=10000
MEDIA_ENGINE_FLIXHQ_STREAMING_PROVIDER_TIMEOUT_MS=15000
MEDIA_ENGINE_VIDEOHUB_STREAMING_PROVIDER_TIMEOUT_MS=20000
# Opt-in guest Filmix lookup: direct MP4, full 480p only, no account or activation.
# Its current metadata API is HTTP; returned CDN media links are HTTPS.
MEDIA_ENGINE_FILMIX_STREAMING_ENABLED=false
# Opt-in VeoVeo lookup: DDBB resolves the public content ID, then VeoVeo returns direct signed HLS.
# The DDBB iframe token is discarded and never requested or exposed.
MEDIA_ENGINE_VEOVEO_STREAMING_ENABLED=false
# Opt-in VideoHUB lookup: Kinopoisk ID to short-lived direct MP4 quality URLs.
# URLs are bound to the playback User-Agent; the HTTP API forwards it per availability request.
# Series require an exact season and episode; no account or token is used.
MEDIA_ENGINE_VIDEOHUB_STREAMING_ENABLED=false
# Opt-in Rutube movie lookup: exact title/year to the official public embed player.
# No account or token is used; series and direct media URLs are intentionally unsupported.
MEDIA_ENGINE_RUTUBE_STREAMING_ENABLED=false
# Torrent discovery is opt-in. Supported names: yts-torrent, jacred-torrent,
# bitsearch-torrent, magnetz-torrent.
MEDIA_ENGINE_TORRENT_PROVIDERS=
MEDIA_ENGINE_TORRENT_PROVIDER_TIMEOUT_MS=15000

# The original-file torrent runtime is not published and starts with the rest of the stack:
# docker compose up -d
MEDIA_ENGINE_TORRSERVER_URL=http://torrserver:8090
MEDIA_ENGINE_TORRSERVER_EXPECTED_VERSION=MatriX.141
# Keep this stable and unique when multiple API deployments share one TorrServer.
MEDIA_ENGINE_TORRSERVER_OWNER_ID=media-engine-compose
MEDIA_ENGINE_TORRSERVER_CONTROL_CONNECT_TIMEOUT_MS=3000
MEDIA_ENGINE_TORRSERVER_CONTROL_REQUEST_TIMEOUT_MS=10000
MEDIA_ENGINE_TORRSERVER_METADATA_TIMEOUT_MS=60000
MEDIA_ENGINE_TORRSERVER_METADATA_POLL_INTERVAL_MS=250
MEDIA_ENGINE_TORRSERVER_COLD_STREAM_HEADER_TIMEOUT_MS=45000
MEDIA_ENGINE_TORRSERVER_COLD_STREAM_INACTIVITY_TIMEOUT_MS=30000
MEDIA_ENGINE_TORRSERVER_MAX_TORRENT_BYTES=4194304
MEDIA_ENGINE_TORRENT_SESSION_TTL_MS=21600000
MEDIA_ENGINE_TORRENT_SESSION_TERMINAL_RETENTION_MS=300000
MEDIA_ENGINE_TORRENT_SESSION_CLEANUP_INTERVAL_MS=10000
MEDIA_ENGINE_TORRENT_SOURCE_REQUEST_TIMEOUT_MS=30000
MEDIA_ENGINE_TORRENT_SESSION_MAX_CONCURRENT_CREATIONS=4
MEDIA_ENGINE_TORRENT_STREAM_MAX_CONCURRENT=8
MEDIA_ENGINE_TORRENT_SESSION_CREATION_RATE_LIMIT_WINDOW_MS=60000
MEDIA_ENGINE_TORRENT_SESSION_CREATION_RATE_LIMIT_MAX_REQUESTS=10
# Required by the API lifecycle routes and the example's server-side BFF. Generate
# one random token with at least 32 non-whitespace characters; never prefix it with VITE_.
MEDIA_ENGINE_ORIGINAL_TORRENT_TOKEN=
MEDIA_ENGINE_TORRSERVER_MEMORY_LIMIT=1g
MEDIA_ENGINE_TORRSERVER_CPUS=2.0
VITE_MEDIA_ENGINE_API_URL=http://127.0.0.1:3000

# Docker Compose publishes on the LAN by default. Use 127.0.0.1 for local-only access.
MEDIA_ENGINE_COMPOSE_BIND_ADDRESS=0.0.0.0

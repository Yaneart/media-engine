HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MEDIA_ENGINE_RATE_LIMIT_WINDOW_MS=60000
MEDIA_ENGINE_RATE_LIMIT_MAX_REQUESTS=60
MEDIA_ENGINE_PROVIDER_TIMEOUT_MS=5000
MEDIA_ENGINE_STREAMING_PROVIDER_TIMEOUT_MS=10000
MEDIA_ENGINE_FLIXHQ_STREAMING_PROVIDER_TIMEOUT_MS=15000
# Torrent discovery is opt-in. Supported names: yts-torrent, jacred-torrent,
# bitsearch-torrent, magnetz-torrent.
MEDIA_ENGINE_TORRENT_PROVIDERS=
MEDIA_ENGINE_TORRENT_PROVIDER_TIMEOUT_MS=15000

# The original-file torrent runtime is internal and started with:
# docker compose --profile torrent-runtime up
MEDIA_ENGINE_TORRSERVER_URL=http://torrserver:8090
MEDIA_ENGINE_TORRSERVER_EXPECTED_VERSION=MatriX.141
MEDIA_ENGINE_TORRSERVER_CONTROL_CONNECT_TIMEOUT_MS=3000
MEDIA_ENGINE_TORRSERVER_CONTROL_REQUEST_TIMEOUT_MS=10000
MEDIA_ENGINE_TORRSERVER_METADATA_TIMEOUT_MS=60000
MEDIA_ENGINE_TORRSERVER_METADATA_POLL_INTERVAL_MS=250
MEDIA_ENGINE_TORRSERVER_COLD_STREAM_HEADER_TIMEOUT_MS=45000
MEDIA_ENGINE_TORRSERVER_COLD_STREAM_INACTIVITY_TIMEOUT_MS=30000
MEDIA_ENGINE_TORRSERVER_MAX_TORRENT_BYTES=4194304
MEDIA_ENGINE_TORRSERVER_MEMORY_LIMIT=1g
MEDIA_ENGINE_TORRSERVER_CPUS=2.0
VITE_MEDIA_ENGINE_API_URL=http://127.0.0.1:3000

# Docker Compose publishes on the LAN by default. Use 127.0.0.1 for local-only access.
MEDIA_ENGINE_COMPOSE_BIND_ADDRESS=0.0.0.0

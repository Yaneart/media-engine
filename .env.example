HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MEDIA_ENGINE_RATE_LIMIT_WINDOW_MS=60000
MEDIA_ENGINE_RATE_LIMIT_MAX_REQUESTS=60
MEDIA_ENGINE_PROVIDER_TIMEOUT_MS=5000
MEDIA_ENGINE_STREAMING_PROVIDER_TIMEOUT_MS=10000
MEDIA_ENGINE_FLIXHQ_STREAMING_PROVIDER_TIMEOUT_MS=15000
MEDIA_ENGINE_TORRENT_PROVIDERS=
MEDIA_ENGINE_TORRENT_PROVIDER_TIMEOUT_MS=15000
MEDIA_ENGINE_JACRED_TORRENT_PROVIDER_TIMEOUT_MS=20000
# Private reference-playback bounds; no playback HTTP route exists yet.
MEDIA_ENGINE_TORRENT_CANDIDATE_TTL_MS=300000
MEDIA_ENGINE_TORRENT_CANDIDATE_CATALOG_SIZE=500
MEDIA_ENGINE_TORRENT_PLAYBACK_SESSION_TTL_MS=1800000
MEDIA_ENGINE_TORRENT_PLAYBACK_START_TIMEOUT_MS=45000
MEDIA_ENGINE_TORRENT_PLAYBACK_MAX_SESSIONS=8
MEDIA_ENGINE_TORRENT_PLAYBACK_MAX_STARTING=2
MEDIA_ENGINE_TORRENT_PLAYBACK_MAX_OFFERED_FILES=100
VITE_MEDIA_ENGINE_API_URL=http://127.0.0.1:3000

# Docker Compose publishes on the LAN by default. Use 127.0.0.1 for local-only access.
MEDIA_ENGINE_COMPOSE_BIND_ADDRESS=0.0.0.0

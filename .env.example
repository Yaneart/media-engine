HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MEDIA_ENGINE_RATE_LIMIT_WINDOW_MS=60000
MEDIA_ENGINE_RATE_LIMIT_MAX_REQUESTS=60
MEDIA_ENGINE_PROVIDER_TIMEOUT_MS=5000
MEDIA_ENGINE_STREAMING_PROVIDER_TIMEOUT_MS=10000
MEDIA_ENGINE_FLIXHQ_STREAMING_PROVIDER_TIMEOUT_MS=15000
MEDIA_ENGINE_TORRENT_PROVIDERS=
MEDIA_ENGINE_TORRENT_PROVIDER_TIMEOUT_MS=15000
MEDIA_ENGINE_JACRED_TORRENT_PROVIDER_TIMEOUT_MS=20000
# Private reference-playback bounds.
MEDIA_ENGINE_TORRENT_CANDIDATE_TTL_MS=300000
MEDIA_ENGINE_TORRENT_CANDIDATE_CATALOG_SIZE=500
MEDIA_ENGINE_TORRENT_PLAYBACK_SESSION_TTL_MS=1800000
MEDIA_ENGINE_TORRENT_PLAYBACK_START_TIMEOUT_MS=120000
MEDIA_ENGINE_TORRENT_PLAYBACK_MAX_SESSIONS=8
MEDIA_ENGINE_TORRENT_PLAYBACK_MAX_STARTING=2
MEDIA_ENGINE_TORRENT_PLAYBACK_MAX_OFFERED_FILES=100
# Optional native-host fallback. Repository Compose keeps ffprobe in the worker.
MEDIA_ENGINE_TORRENT_PLAYBACK_FFPROBE_PATH=
# Set this URL with the torrent-playback profile; leave blank for heuristic fallback.
MEDIA_ENGINE_TORRENT_PLAYBACK_MEDIA_WORKER_URL=
MEDIA_ENGINE_TORRENT_PLAYBACK_MEDIA_WORKER_TIMEOUT_MS=25000
MEDIA_ENGINE_TORRENT_PLAYBACK_MEDIA_WORKER_REMUX_TIMEOUT_MS=605000
MEDIA_ENGINE_TORRENT_PLAYBACK_MEDIA_PROBE_TIMEOUT_MS=20000
MEDIA_ENGINE_TORRENT_MEDIA_WORKER_MAX_CONCURRENCY=2
MEDIA_ENGINE_TORRENT_MEDIA_WORKER_MAX_REQUEST_BYTES=16384
MEDIA_ENGINE_TORRENT_MEDIA_WORKER_REQUEST_TIMEOUT_MS=22000
MEDIA_ENGINE_TORRENT_MEDIA_WORKER_MAX_REMUX_CONCURRENCY=1
MEDIA_ENGINE_TORRENT_MEDIA_WORKER_MAX_STORED_BYTES=17179869184
MEDIA_ENGINE_TORRENT_MEDIA_WORKER_OUTPUT_TTL_MS=1800000
MEDIA_ENGINE_TORRENT_PLAYBACK_FFMPEG_PATH=
MEDIA_ENGINE_TORRENT_MEDIA_REMUX_OUTPUT_DIRECTORY=/var/lib/media-engine/remux
MEDIA_ENGINE_TORRENT_MEDIA_REMUX_TIMEOUT_MS=600000
MEDIA_ENGINE_TORRENT_MEDIA_REMUX_MAX_OUTPUT_BYTES=8589934592
MEDIA_ENGINE_TORRENT_PLAYBACK_MAX_STREAMS=8
MEDIA_ENGINE_TORRENT_PLAYBACK_STREAM_HEADER_TIMEOUT_MS=30000
MEDIA_ENGINE_TORRENT_PLAYBACK_STREAM_IDLE_TIMEOUT_MS=30000
# Reference playback stays disabled while URL and token are blank. For the bundled
# Compose profile use http://torrserver:8090; generate the token with openssl rand -base64 32.
MEDIA_ENGINE_TORRSERVER_URL=
MEDIA_ENGINE_TORRSERVER_USERNAME=
MEDIA_ENGINE_TORRSERVER_PASSWORD=
MEDIA_ENGINE_TORRSERVER_CONNECT_TIMEOUT_MS=15000
MEDIA_ENGINE_TORRSERVER_REQUEST_TIMEOUT_MS=40000
MEDIA_ENGINE_TORRSERVER_METADATA_TIMEOUT_MS=60000
MEDIA_ENGINE_TORRSERVER_METADATA_POLL_INTERVAL_MS=250
MEDIA_ENGINE_TORRENT_PLAYBACK_TOKEN=
# Server-side URL used only by the example dev server's narrow lifecycle BFF.
# Compose overrides this with http://api:3000. Never prefix the playback token with VITE_.
MEDIA_ENGINE_REFERENCE_PLAYER_API_URL=http://127.0.0.1:3000
MEDIA_ENGINE_TORRENT_PLAYBACK_RATE_LIMIT_WINDOW_MS=60000
MEDIA_ENGINE_TORRENT_PLAYBACK_RATE_LIMIT_MAX_REQUESTS=10
# Resource limits for the opt-in bundled TorServer Compose profile.
MEDIA_ENGINE_TORRSERVER_MEMORY_LIMIT=1g
MEDIA_ENGINE_TORRSERVER_CPUS=2.0
MEDIA_ENGINE_TORRENT_MEDIA_WORKER_MEMORY_LIMIT=512m
MEDIA_ENGINE_TORRENT_MEDIA_WORKER_CPUS=1.0
VITE_MEDIA_ENGINE_API_URL=http://127.0.0.1:3000

# Docker Compose publishes on the LAN by default. Use 127.0.0.1 for local-only access.
MEDIA_ENGINE_COMPOSE_BIND_ADDRESS=0.0.0.0
